  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://wiki.intertrendhub.com",
        "label": "Company Wiki"
      }
    ],
    "primary": {
      "type": "button",
      "label": "InterHub",
      "href": "https://intertrendhub.com"
    }
  },
  "footer": {
    "socials": {
    }
  },
